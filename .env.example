# DEV-ONLY LLM config (Lightning AI / any OpenAI-compatible endpoint).
# Vite inlines VITE_* into the client bundle — DEV ONLY, never used in production.
# Copy to .env.local and fill in. `npm run dev` and `npm run tauri:dev` pick it up
# on mount. Production uses the OS keychain instead (npm run setup:install).
#
# Caveats:
# - VITE_* values are embedded in the client bundle — use only for local dev.
# - `npm run tauri:dev` is the reliable path for real Lightning calls (native
#   webview, CSP-governed). Plain `npm run dev` may be CORS-blocked by the host.
# - Add the origin of VITE_LLM_BASE_URL to connect-src in src-tauri/tauri.conf.json
#   (e.g. https://api.lightning.ai for the default Lightning endpoint).
VITE_LLM_PROVIDER=openai-compatible
VITE_LLM_MODEL=<your Lightning model name>
VITE_LLM_BASE_URL=<your Lightning OpenAI-compatible base URL, ending in /v1>
VITE_LLM_API_KEY=<your Lightning API key>
